# Copie para as variaveis de ambiente do servico no Easypanel.
# Postgres (servico "db" do projeto tudoehfesta no Easypanel: Credentials > Internal connection URL). Sem isso usa banco local de teste.
DATABASE_URL=postgres://postgres:SENHA@tudoehfesta_db:5432/tudoehfesta?sslmode=disable
# Texto longo e aleatorio: assina as sessoes de login.
SESSION_SECRET=
# Endereco publico do site (usado no retorno do Mercado Pago e no webhook).
PUBLIC_URL=https://www.tudoehfesta.com
# Primeiro administrador: criado na primeira inicializacao se ainda nao existir.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Mercado Pago (opcional): Access Token de PRODUCAO das credenciais da aplicacao. Sem ele, o site usa Pix manual.
MP_ACCESS_TOKEN=
# InfinitePay (opcional): sua InfiniteTag (sem o $). Nao e senha. Com Mercado Pago e InfinitePay ativos, escolha no admin quem atende Pix e cartao.
INFINITEPAY_HANDLE=
# Google Drive (opcional): importa as pastas do ano. Use UMA das duas:
#  - conta de servico (recomendado; pastas ficam privadas, compartilhadas com o e-mail da conta): JSON inteiro da chave
GOOGLE_SERVICE_ACCOUNT_JSON=
#  - chave de API (pastas precisam estar como "qualquer pessoa com o link")
GOOGLE_API_KEY=
DRIVE_SYNC_MINUTES=10
# Opcionais
WATERMARK_TEXT=tudoehfesta.com
MAX_UPLOAD_MB=40
